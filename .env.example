# Copy to .env and fill in only what you use. Never commit .env.

# --- WhatsApp Cloud API (Meta) : provider = "cloud" ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Optional: approved template name. Required to message parents outside the 24h window.
# Body parameters are sent in this order: parent, student, date, class, percentage
WHATSAPP_TEMPLATE=  
WHATSAPP_TEMPLATE_LANG=en

# --- Twilio WhatsApp : provider = "twilio" ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+14155238886
